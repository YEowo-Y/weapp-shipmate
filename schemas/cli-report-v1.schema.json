{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "weapp-shipmate CLI report v1",
  "description": "Report emitted by --json --json-version 1. Additional fields may be added within this version.",
  "type": "object",
  "required": ["schemaVersion", "command", "meta", "items", "notes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "command": { "type": "string", "enum": ["check", "guide", "explain"] },
    "meta": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "truncated"],
          "properties": {
            "schemaVersion": { "type": "integer", "const": 1 },
            "truncated": { "type": "boolean" }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "evidence": { "$ref": "#/definitions/evidence" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "selfCheck": { "type": "array", "items": { "type": "object" } }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "guide" } } },
      "then": { "required": ["selfCheck"] }
    },
    {
      "if": { "properties": { "meta": { "type": "object", "required": ["evidence"] } } },
      "then": {
        "properties": {
          "command": { "const": "check" },
          "items": { "type": "array", "items": { "type": "object", "required": ["evidence"] } }
        }
      }
    },
    {
      "if": { "properties": { "items": { "type": "array", "contains": { "type": "object", "required": ["evidence"] } } } },
      "then": { "properties": { "meta": { "type": "object", "required": ["evidence"] } } }
    }
  ],
  "definitions": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column", "kind", "signal"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f`]+(?:/[^/\\\\\\u0000-\\u001f\\u007f`]+)*$"
        },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "kind": { "enum": ["api-reference", "api-import", "domain", "insecure-request", "config-key", "secret-key"] },
        "signal": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "properties": { "line": { "type": "integer" }, "column": { "type": "integer" } } },
        { "properties": { "line": { "type": "null" }, "column": { "type": "null" } } }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "locations"],
      "properties": {
        "status": { "enum": ["located", "partial", "unavailable"] },
        "locations": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/location" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "located" } } },
          "then": {
            "properties": {
              "locations": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "object", "properties": { "line": { "type": "integer" }, "column": { "type": "integer" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "locations": { "type": "array", "maxItems": 0 } } }
        }
      ]
    }
  }
}
