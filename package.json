{
  "name": "weapp-shipmate",
  "version": "0.2.0-rc.1",
  "description": "你写代码，我陪你上线 —— 微信小程序合规上线导航与代码感知预检（规则即数据）。CLI 内核 + MCP 适配层；预检支持原生 wx / uni-app / Taro / mpvue / mpx / wepy。",
  "type": "module",
  "license": "MIT",
  "author": "YEowo-Y",
  "keywords": [
    "weapp",
    "miniprogram",
    "wechat-miniprogram",
    "小程序",
    "上线",
    "合规",
    "compliance",
    "preflight",
    "mcp",
    "uni-app",
    "taro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YEowo-Y/weapp-shipmate.git"
  },
  "bugs": {
    "url": "https://github.com/YEowo-Y/weapp-shipmate/issues"
  },
  "homepage": "https://github.com/YEowo-Y/weapp-shipmate#readme",
  "bin": {
    "weapp-shipmate": "bin/weapp-shipmate.mjs",
    "weapp-shipmate-mcp": "bin/weapp-shipmate-mcp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "schemas/",
    "rules/",
    "flow.yaml",
    "rejections.yaml"
  ],
  "scripts": {
    "test": "node scripts/validate.mjs && node --test",
    "validate": "node scripts/validate.mjs",
    "lint:rules": "node scripts/validate.mjs",
    "check": "node bin/weapp-shipmate.mjs check",
    "guide": "node bin/weapp-shipmate.mjs guide",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "rot": "node scripts/rule-rot.mjs",
    "accuracy": "node scripts/accuracy.mjs",
    "lint": "eslint .",
    "pin:fixtures": "node scripts/pin-fixtures.mjs",
    "coverage": "node scripts/coverage.mjs",
    "dogfood": "node scripts/dogfood.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.6.0"
  }
}
