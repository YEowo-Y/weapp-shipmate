{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window: bounded project tools, model broker, folder picker and web references",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "allow-project-snapshot",
    "allow-project-save",
    "allow-project-select",
    "allow-project-artifact",
    "allow-project-export",
    "allow-project-storage-status",
    "allow-project-import-preview",
    "allow-project-import",
    "allow-project-archive-prepare",
    "allow-project-archive-commit",
    "allow-project-run",
    "allow-project-repair-prepare",
    "allow-project-repair-apply",
    "allow-project-repair-undo-prepare",
    "allow-project-repair-undo",
    "allow-project-repair-recovery-prepare",
    "allow-project-repair-snapshot",
    "allow-project-repair-record-recheck",
    "allow-project-facts-save",
    "allow-project-workflow",
    "allow-project-stage-confirm",
    "allow-project-compare",
    "allow-project-context-file",
    "allow-project-context-report",
    "allow-project-memory-snapshot",
    "allow-project-memory-save",
    "allow-project-memory-delete",
    "allow-project-memory-context",
    "allow-project-maintenance-sync",
    "allow-project-maintenance-snapshot",
    "allow-project-maintenance-save",
    "allow-project-maintenance-retry",
    "allow-project-maintenance-read",
    "allow-project-maintenance-stop",
    "allow-source-freshness-snapshot",
    "allow-source-freshness-check",
    "allow-system-notifications-snapshot",
    "allow-system-notifications-save",
    "allow-system-notifications-test",
    "allow-run-check",
    "allow-run-guide",
    "allow-run-cancel",
    "allow-model-request",
    "allow-model-cancel",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
